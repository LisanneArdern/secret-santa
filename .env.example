# Copy to .env.local for local development (next dev / next build read it
# automatically). Values below are the standard local Supabase CLI
# defaults (`npx supabase status`); use your project's real values in
# Vercel for staging/production.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
