# Copy to .env.local for local development (next dev / next build read it
# automatically). Values below are the standard local Supabase CLI
# defaults (`npx supabase status`); use your project's real values in
# Vercel for staging/production.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used to build links in notification emails (invite, draw, etc.).
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Optional locally: without these, notification emails are logged and
# skipped rather than sent (src/lib/email/send-safely.ts) — every other
# action (creating a round, drawing, etc.) still works. Required in
# production for emails to actually go out.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Santa Swap <onboarding@resend.dev>
# From the Resend webhook's settings page once configured there, for
# POST /api/webhooks/resend to verify bounce notifications.
RESEND_WEBHOOK_SECRET=

# Shared secret for the scheduled jobs under src/app/api/cron/ (reminders,
# completion, archival — see vercel.json). Vercel sets this automatically
# in production and sends it as a bearer token on every cron-triggered
# request; set any random value locally if you want to call these routes
# by hand.
CRON_SECRET=
